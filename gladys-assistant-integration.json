{
  "manifest_version": 1,
  "type": "device",
  "name": "AirNow",
  "description": {
    "en": "U.S. air quality from AirNow (EPA): AQI now, forecast and alerts for your places.",
    "fr": "Qualité de l’air AirNow (EPA, États-Unis) : AQI actuel, prévision et alertes.",
    "de": "US-Luftqualität von AirNow (EPA): aktueller AQI, Vorhersage und Warnungen.",
    "es": "Calidad del aire de AirNow (EPA, EE. UU.): AQI actual, previsión y alertas."
  },
  "version": "0.1.1",
  "docker_image": "ghcr.io/william-de71/gladys-airnow:0.1.1",
  "gladys_version": ">=5.3.0",
  "categories": ["environment"],
  "keywords": [
    "EPA",
    "AQI",
    "Air Quality Index",
    "air quality",
    "qualité de l'air",
    "ozone",
    "PM2.5",
    "pollution",
    "ZIP code"
  ],
  "countries": ["US", "CA", "MX"],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-airnow/main/cover.jpg",
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "AirNow API key",
        "fr": "Clé d’API AirNow",
        "de": "AirNow-API-Schlüssel",
        "es": "Clave de API de AirNow"
      },
      "description": {
        "en": "AirNow is the air quality program of the U.S. EPA, with its state, local and tribal partners: observations and forecasts of the Air Quality Index for the United States, Canada and Mexico. Its API needs a free key: request an account, then copy the key shown at the top right of its Web Services page.",
        "fr": "AirNow est le programme de qualité de l’air de l’EPA américaine et de ses partenaires locaux : mesures et prévisions de l’indice AQI pour les États-Unis, le Canada et le Mexique. Son API demande une clé gratuite : créez un compte, puis copiez la clé affichée en haut à droite de sa page Web Services.",
        "de": "AirNow ist das Luftqualitätsprogramm der US-Umweltbehörde EPA und ihrer Partner: Messwerte und Vorhersagen des AQI für die USA, Kanada und Mexiko. Die API braucht einen kostenlosen Schlüssel: Beantrage ein Konto und kopiere dann den Schlüssel oben rechts auf der Seite Web Services.",
        "es": "AirNow es el programa de calidad del aire de la EPA de EE. UU. y de sus socios: mediciones y previsiones del índice AQI para Estados Unidos, Canadá y México. Su API necesita una clave gratuita: solicite una cuenta y copie la clave que aparece arriba a la derecha de su página Web Services."
      },
      "links": [
        {
          "url": "https://docs.airnowapi.org/account/request/",
          "label": {
            "en": "Request an AirNow API account",
            "fr": "Demander un compte AirNow API",
            "de": "AirNow-API-Konto beantragen",
            "es": "Solicitar una cuenta de AirNow API"
          }
        },
        {
          "url": "https://docs.airnowapi.org/login",
          "label": {
            "en": "Log in to find your key",
            "fr": "Se connecter pour trouver la clé",
            "de": "Anmelden, um den Schlüssel zu finden",
            "es": "Iniciar sesión para ver la clave"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "required": true,
      "label": {
        "en": "API key",
        "fr": "Clé d’API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "placeholder": {
        "en": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX",
        "fr": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX",
        "de": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX",
        "es": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
      }
    },
    {
      "key": "places",
      "type": "section",
      "label": {
        "en": "Place 1",
        "fr": "Lieu 1",
        "de": "Ort 1",
        "es": "Lugar 1"
      },
      "description": {
        "en": "Up to three places, each a house of Gladys or a ZIP code. AirNow answers with the nearest reporting area and its monitors (within about 50 miles).",
        "fr": "Jusqu’à trois lieux, chacun une maison de Gladys ou un code ZIP. AirNow répond avec la zone de mesure la plus proche et ses stations (dans un rayon d’environ 80 km).",
        "de": "Bis zu drei Orte, jeweils ein Haus in Gladys oder eine ZIP-Postleitzahl. AirNow antwortet mit dem nächsten Berichtsgebiet und seinen Messstationen (im Umkreis von etwa 80 km).",
        "es": "Hasta tres lugares, cada uno una casa de Gladys o un código ZIP. AirNow responde con la zona de medición más cercana y sus estaciones (en un radio de unos 80 km)."
      }
    },
    {
      "key": "house_1",
      "type": "select",
      "source": "houses",
      "label": {
        "en": "House",
        "fr": "Maison",
        "de": "Haus",
        "es": "Casa"
      },
      "description": {
        "en": "Its location in Gladys locates the place (United States, Canada, Mexico).",
        "fr": "Sa position dans Gladys situe le lieu (États-Unis, Canada, Mexique).",
        "de": "Ihr Standort in Gladys bestimmt den Ort (USA, Kanada, Mexiko).",
        "es": "Su ubicación en Gladys sitúa el lugar (Estados Unidos, Canadá, México)."
      }
